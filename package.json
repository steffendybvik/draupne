{
  "name": "draupne",
  "version": "0.1.0",
  "description": "Local-first personal finance PWA built with Nuxt 4 and Tailwind 4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "npx serve .output/public",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "deploy": "nuxt generate && wrangler pages deploy .output/public --project-name draupne",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
